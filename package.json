{
  "name": "@yxzpro/dsh-debug",
  "version": "0.1.0",
  "description": "Runtime debugger for DeepSeek Harness — DAP (Delve/Go) and DBGp (Xdebug/PHP) sessions that agents can drive as tools, with a sidebar UI on top.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/run-phase0.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxzpro/dsh-debug.git"
  },
  "keywords": [
    "dsh-plugin",
    "debugger",
    "dap",
    "delve",
    "xdebug",
    "deepseek-harness"
  ],
  "author": "yxzpro"
}
